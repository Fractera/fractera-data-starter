# dependencies
node_modules/

# generated by the installer — never edited by hand, never in git
.env.local
.env
.env.*.local

# the person's own data: database, uploaded files, generated icons.
# Only the .gitkeep of each folder is tracked, so the shape survives a clone.
data/*
!data/.gitkeep
storage/*
!storage/.gitkeep
icons/*
!icons/.gitkeep

# logs and os
*.log
.DS_Store
Thumbs.db
