# dependencies
node_modules/

# generated by the installer — never edited by hand, never in git
.env.local
.env
.env.*.local

# the person's own data: database, uploaded files, generated icons.
# Only the .gitkeep of each folder is tracked, so the shape survives a clone.
data/*
!data/.gitkeep
storage/*
!storage/.gitkeep
icons/*
!icons/.gitkeep

# logs and os
*.log
.DS_Store
Thumbs.db

# 285-4: сборки страницы на Next (корень службы, чередуются .next-a / .next-b) и метка текущей
.next
.next-a
.next-b
.presentation-dist
.presentation-dist.*.tmp
presentation/next-env.d.ts
presentation/tsconfig.tsbuildinfo
*.tsbuildinfo

# 315: font files copied from @fontsource packages before each build (scripts/local-fonts.mjs)
presentation/public/fonts/
